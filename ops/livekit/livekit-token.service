[Unit]
Description=Kenichi LiveKit listener token service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/livekit-token
ExecStart=/usr/bin/node /opt/livekit-token/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
